BOT_TOKEN=your_bot_token_here
DOWNLOAD_DIR=/tmp/tiktok_bot
MAX_FILE_SIZE=52428800
# Admin Telegram (ID angka, bukan username) untuk /restart dan /logs.
# Ambil ID kamu dari @userinfobot. Bisa satu (ADMIN_ID) atau banyak (ADMIN_IDS,
# dipisah koma). Kosongkan keduanya = tidak ada admin.
ADMIN_ID=
ADMIN_IDS=

RATE_LIMIT_COUNT=5
RATE_LIMIT_WINDOW=60

# Konversi dokumen /pdf dan /word
# Ambil kunci dari https://developer.ilovepdf.com/user/projects (gratis 250 file/bulan)
ILOVEPDF_PUBLIC_KEY=
ILOVEPDF_SECRET_KEY=
# Opsional: wilayah pemrosesan (eu/us/fr/de/pl/in/sg). Kosongkan untuk default
ILOVEPDF_REGION=
# Batas ukuran dokumen yang bisa dikonversi (Telegram getFile maksimal 20MB)
CONVERT_MAX_FILE_SIZE=20971520
# Timeout per request konversi, detik
CONVERT_TIMEOUT=120
# Jumlah konversi yang boleh berjalan bersamaan
CONVERT_MAX_CONCURRENT=2

# --- Server monitor (/status dan /health) ---
# Ambang batas persen: status NORMAL < WARNING <= CRITICAL
CPU_WARNING=70
CPU_CRITICAL=90
RAM_WARNING=80
RAM_CRITICAL=90
DISK_WARNING=80
DISK_CRITICAL=90
# Ruang disk minimum (MB) sebelum /health memberi WARNING
MIN_FREE_DISK_MB=500
# Timeout (detik) tiap pemeriksaan koneksi eksternal di /health
HEALTH_TIMEOUT=5

# --- Log (/logs, khusus admin) ---
# File log rotating yang dibaca /logs. Default: logs/bot.log di direktori proyek.
#LOG_FILE=/path/ke/bot.log
# Ukuran maksimal file log (byte) sebelum dirotasi
LOG_MAX_BYTES=1048576
# Jumlah file log lama yang disimpan
LOG_BACKUP_COUNT=3

# --- Statistik (/stats) ---
# File JSON persisten untuk statistik bot. Default: data/stats.json
#STATS_FILE=/path/ke/stats.json
